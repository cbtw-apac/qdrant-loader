# HarborRAG FastAPI runtime image.
# Runs the HTTP API facade and delegates business logic to the configured runtime composition.
FROM python:3.12-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    HARBORRAG_HOST=0.0.0.0 \
    HARBORRAG_PORT=8000

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml README.md ./
COPY packages ./packages

RUN python -m pip install --upgrade pip \
    && python -m pip install -e packages/harborrag-core \
    && python -m pip install -e packages/harborrag-adapters \
    && python -m pip install -e packages/harborrag-engine \
    && python -m pip install -e packages/harborrag-memory \
    && python -m pip install -e packages/harborrag-runtime \
    && python -m pip install -e 'packages/harborrag-app[api]' \
    && python -m pip install -e packages/harborrag-mcp \
    && python -m pip install -e packages/harborrag

EXPOSE 8000

CMD ["sh", "-c", "uvicorn harborrag_app.api.app:create_fastapi_app --factory --host ${HARBORRAG_HOST} --port ${HARBORRAG_PORT}"]
